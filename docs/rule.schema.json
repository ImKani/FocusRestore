{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ImKani/FocusRestore/blob/master/docs/rule.schema.json",
  "title": "FocusRestore island text rule v1 (C1 contract)",
  "description": "ImKani / FocusRestore / GPL-3.0-only. C1 immutable model and strict decoder only; no runtime integration.",
  "$comment": "File <=65536 UTF-8 bytes including whitespace. Strict reader: container depth <=8 (root=1), object keys <=64, array items <=32, key <=256 UTF-16 units, string and number token <=4096 UTF-16 units. All apply inside x-* annotations; annotations do not enter the model. Schema maxLength counts code points; decoder additionally checks UTF-16 units. Duplicate keys, strict UTF-8, date-time assertions, cross references and L3/R need hand validation. No remote schema loading. Runtime quotas are contract only in C1. See island-rules-spec.md and island-rule-paths.md.",
  "x-jsonMaxDepth": 8,
  "x-maxObjectKeys": 64,
  "x-maxArrayItems": 32,
  "x-maxKeyUtf16Units": 256,
  "x-maxStringUtf16Units": 4096,
  "x-maxPathSegments": 8,
  "x-pathClassification": "106 canonical paths: structural=11, freeText=95, unsafe=0. Capture/export preserves structural values by default and placeholders freeText; runtime does not redact either class. Structural describes field semantics, not verified input types. No aliases. See island-rule-paths.md and island-rules-spec.md section 7.",
  "x-maxUtf8Bytes": 65536,
  "x-forbiddenKeys": [
    "code",
    "script",
    "expression",
    "eval",
    "exec",
    "class",
    "method",
    "reflection",
    "url",
    "network",
    "file",
    "filePath",
    "intent",
    "Intent",
    "action",
    "Action",
    "pendingIntent",
    "PendingIntent",
    "layout",
    "style",
    "view",
    "color",
    "font",
    "html",
    "regex"
  ],
  "type": "object",
  "additionalProperties": false, "patternProperties": {"^x-": true},
  "properties": {
