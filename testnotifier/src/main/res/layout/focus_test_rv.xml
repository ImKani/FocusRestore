<?xml version="1.0" encoding="utf-8"?>
<!--
  Stands in for the notification application's own miui.focus.rv layout. Its wording is
  deliberately what the travel app publishes in aodTitle, so the pill's behaviour with (and
  without) this RemoteViews present is directly comparable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/rv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:text="检票口 检票口" />

    <TextView
        android:id="@+id/rv_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:text="D8396" />

</LinearLayout>
